VictoryRoad_Text_RivalBefore:
    .string "Espera.\p"
    .string "...¿Vas a intentar el reto de la\n"
    .string "LIGA POKéMON?\p"
    .string "...No me hagas reír.\p"
    .string "Eres mucho más débil que yo.\p"
    .string "Ya no soy el de antes.\p"
    .string "Ahora tengo los POKéMON más fuertes\n"
    .string "a mi lado.\p"
    .string "¡Soy invencible!\p"
    .string "{PLAYER}!\n"
    .string "¡Te desafío!$"

VictoryRoad_Text_RivalDefeat:
    .string "...No pude ganar...\p"
    .string "Lo di todo de mí...\p"
    .string "Lo que tú tienes y yo no...\p"
    .string "Empiezo a entender lo que aquel\n"
    .string "maestro dragón me dijo...$"

VictoryRoad_Text_RivalAfter:
    .string "...No he renunciado a ser el\n"
    .string "mejor entrenador...\p"
    .string "Averiguaré por qué no gano\n"
    .string "y me haré más fuerte...\p"
    .string "Cuando lo logre, te desafiaré.\p"
    .string "Y te derrotaré con todo mi\n"
    .string "poder.\p"
    .string "...¡Hmph! Sigue así hasta entonces.$"
