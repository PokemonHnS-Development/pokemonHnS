	release
	end

MeteorFalls_1F_1R_Text_WithThisMeteorite:
	.string "¡Jejeje!\p"
	.string "Con este METEORITO, aquello en el\n"
	.string "MT. CHIMNEY hará que…$"

MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma:
	.string "¿Eh?\p"
	.string "No sé quién eres, pero si estorbas al\n"
	.string "TEAM MAGMA, ¡no esperes\l"
	.string "piedad!$"

MeteorFalls_1F_1R_Text_HoldItRightThereMagma:
	.string "¡Deténganse ahí, TEAM MAGMA!\p"
	.string "¡Se equivocan si creen que pueden\n"
	.string "hacer lo que quieran con el mundo!$"

MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua:
	.string "¡Jejeje!\n"
	.string "¡Hasta el TEAM AQUA se une!\p"
	.string "Pero es mucha molestia lidiar con\n"
	.string "todos ustedes…\p"
	.string "¡Je, no importa!\p"
	.string "Tenemos el METEORITO, ¡así que vamos\n"
	.string "al MT. CHIMNEY!\p"
	.string "¡Jejeje! ¡Nos vemos, tontos del\n"
	.string "TEAM AQUA!$"

MeteorFalls_1F_1R_Text_ArchieSeenYouBefore:
	.string "ARCHIE: ¿No te vi antes?\n"
	.string "¿En el MUSEO de SLATEPORT?\p"
	.string "Ah, así que te llamas {PLAYER}.\p"
	.string "En ese momento, pensé que eras un\n"
	.string "matón del TEAM MAGMA.\p"
	.string "Humph…\n"
	.string "Eres un chico extraño.\p"
	.string "El TEAM MAGMA es un grupo peligroso\n"
	.string "de fanáticos totales.\p"
	.string "Destruyen todo para decir que\n"
	.string "expandirán la tierra.\p"
	.string "Ellos son los rivales de nosotros,\n"
	.string "¡el TEAM AQUA que ama el mar!$"

MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma:
	.string "JEFE, deberíamos perseguir al\n"
	.string "TEAM MAGMA…$"

MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo:
	.string "ARCHIE: ¡Sí, sí, debemos hacerlo!\n"
	.string "Tenemos que darnos prisa.\p"
	.string "¡No sabemos qué hará el TEAM MAGMA\n"
	.string "en el MT. CHIMNEY!$"

MeteorFalls_1F_1R_Text_ArchieFarewell:
	.string "ARCHIE: {PLAYER}, tú también deberías\n"
	.string "vigilar al TEAM MAGMA.\p"
	.string "¡Adiós!$"

MeteorFalls_1F_1R_Text_MeetProfCozmo:
	.string "Yo... soy COZMO...\n"
	.string "Soy PROFESOR...\p"
	.string "TEAM MAGMA me pidió guiarlos\n"
	.string "a METEOR FALLS...\p"
	.string "Pero me engañaron.\n"
	.string "Hasta me quitaron mi METEORITO...\p"
	.string "Y luego apareció otro grupo\n"
	.string "similar, el TEAM AQUA.\p"
	.string "Después de eso...\n"
	.string "No entiendo nada de esto.\p"
	.string "Pero ese TEAM MAGMA...\p"
	.string "¿Qué harán con ese METEORITO\n"
	.string "en el MT. CHIMNEY?$"

MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney:
	.string "PROF. COZMO: Pero ese TEAM MAGMA...\p"
	.string "¿Qué harán con ese METEORITO\n"
	.string "en el MT. CHIMNEY?$"
