Route110_TrickHousePuzzle7_Text_WroteSecretCodeLockOpened::
	.string "{PLAYER} anotó el código secreto\n"
	.string "en la puerta.\p"
	.string "“TRICK MASTER es abrazable”.\n"
	.string "… … … … … … … …\p"
	.string "¡La cerradura se abrió!$"

Route110_TrickHousePuzzle7_Text_JoshuaIntro:
	.string "TRICK MASTER siempre desaparece\n"
	.string "como el humo. ¿Cómo lo hace?$"

Route110_TrickHousePuzzle7_Text_JoshuaDefeat:
	.string "¡Aiyeeeh! ¡Eres muy fuerte!\n"
	.string "¿Cómo lo haces?$"

Route110_TrickHousePuzzle7_Text_JoshuaPostBattle:
	.string "Desearía aparecer y desaparecer\n"
	.string "como si fuera humo yo también.$"

Route110_TrickHousePuzzle7_Text_PatriciaIntro:
	.string "Dar vueltas en el mismo sitio…\n"
	.string "Trae mala suerte…$"

Route110_TrickHousePuzzle7_Text_PatriciaDefeat:
	.string "¡Derrotado!\n"
	.string "Es una mala señal…$"

Route110_TrickHousePuzzle7_Text_PatriciaPostBattle:
	.string "He dado vueltas al mismo sitio más\n"
	.string "de diez veces… Es mala suerte…$"

Route110_TrickHousePuzzle7_Text_AlexisIntro:
	.string "Quien gane pasará por aquí\n"
	.string "primero. Eso es lo que siento.$"

Route110_TrickHousePuzzle7_Text_AlexisDefeat:
	.string "¡Oh!\n"
	.string "¡Bueno, adelante entonces!$"

Route110_TrickHousePuzzle7_Text_AlexisPostBattle:
	.string "Resuelves todo en la\n"
	.string "CASA TRUCOS. Eso es lo que siento.$"

Route110_TrickHousePuzzle7_Text_MarielaIntro:
	.string "¡Nufufufu, al fin llegaste!\n"
	.string "¡Vayamos directo al grano!$"

Route110_TrickHousePuzzle7_Text_MarielaDefeat:
	.string "¡Te tomas ganar muy a la ligera!$"

Route110_TrickHousePuzzle7_Text_MarielaPostBattle:
	.string "¡Humph! ¡No estoy molesto!\n"
	.string "¡Yo no!$"

Route110_TrickHousePuzzle7_Text_AlvaroIntro:
	.string "¡Te observé muy de cerca al venir!$"

Route110_TrickHousePuzzle7_Text_AlvaroDefeat:
	.string "No vi venir este resultado…$"

Route110_TrickHousePuzzle7_Text_AlvaroPostBattle:
	.string "Bueno, elegimos un lugar raro\n"
	.string "para conocernos.\p"
	.string "De un raro a otro,\n"
	.string "¡demos lo mejor de nosotros!$"

Route110_TrickHousePuzzle7_Text_EverettIntro:
	.string "Está muy apretado aquí adentro…$"

Route110_TrickHousePuzzle7_Text_EverettDefeat:
	.string "Oh, sí, eres muy fuerte.$"

Route110_TrickHousePuzzle7_Text_EverettPostBattle:
	.string "Esperaba cambiar mi lugar por el tuyo\n"
	.string "al vencerte, pero…$"

