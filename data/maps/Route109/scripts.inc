DewfordTown_Text_BrineyLandedInSlateportDeliverGoods:
	.string "SR. BRINEY: ¡Ahoy!\n"
	.string "¡Llegamos a FONSALUD!\p"
	.string "¿Vas a visitar al CAPT.\n"
	.string "STERN y dar los PRODUCTOS DEVON?$"

Route109_Text_BrineySailToDewfordQuestion:
	.string "SR. BRINEY: Creí que debías\n"
	.string "dar los PRODUCTOS DEVON.\p"
	.string "¿Quieres volver a\n"
	.string "SOTAVENTO, entonces?$"

Route109_Text_BrineyDewfordItIs:
	.string "SR. BRINEY: ¡A SOTAVENTO vamos!\p"
	.string "¡Leven anclas!\n"
	.string "¡PEEKO, zarpamos, cariño mío!$"

Route109_Text_BrineyDeliverDevonGoods:
	.string "SR. BRINEY: Entonces ve a entregar\n"
	.string "los PRODUCTOS DEVON. Esperaré.$"

DewfordTown_Text_BrineyLandedInSlateport:
	.string "SR. BRINEY: ¡Ahoy! ¡Llegamos a\n"
	.string "FONSALUD!\p"
	.string "¡Dime cuando quieras que\n"
	.string "zarpemos de nuevo!$"

Route109_Text_BrineyWhereAreWeBound:
	.string "SR. BRINEY: ¡Ahoy!\n"
	.string "¡Iré al mar por ti cuando sea!\p"
	.string "Amigo, ¿a dónde nos dirigimos?$"

Route109_Text_BrineyTellMeWhenYouNeedToSail:
	.string "SR. BRINEY: ¡Solo dime cuando\n"
	.string "necesites zarpar de nuevo!$"

Route109_Text_ChillAtMyPapasSpot:
	.string "¡Hola, ENTRENADORES!\n"
	.string "Si tienen ganas de acción,\l"
	.string "o prefieren relax,\l"
	.string "¡vengan al local de mi papá!$"

Route109_Text_LittleKidsDartAround:
	.string "Los niños corren muy rápido...\p"
	.string "No puedes quitarles la vista de\n"
	.string "encima ni un segundo. Es agotador.\p"
	.string "Los míos están con mis POKéMON, así\n"
	.string "que estarán bien, pero...$"

