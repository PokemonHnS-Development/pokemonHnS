Route112_Text_LeaderGoingToAwakenThing:
	.string "Oye, ¿nuestro líder despertará\n"
	.string "realmente a esa cosa?$"

Route112_Text_YeahWeNeedMeteorite:
	.string "Parece que sí. Pero oí que\n"
	.string "necesitamos un METEORITO para ello.$"

Route112_Text_OhThatsWhyCrewWentToFallarbor:
	.string "Ya entiendo. Por eso el resto\n"
	.string "del grupo fue a FALLARBOR.$"

Route112_Text_CantLetAnyonePassUntilTheyreBack:
	.string "Exacto. Hasta que vuelvan,\n"
	.string "no dejaremos pasar a nadie, ¿no?$"

Route112_Text_NotEasyToGetBackToLavaridge:
	.string "Quisiera ir a MAUVILLE, pero si\n"
	.string "bajo por aquí, no sería fácil\l"
	.string "volver a LAVARIDGE.$"

Route112_Text_MtChimneyCableCarSign:
	.string "CABLE CAR DEL MT. CHIMNEY\n"
	.string "¡Un corto paseo hacia {UP_ARROW}!$"

Route112_Text_MtChimneySign:
	.string "MT. CHIMNEY\p"
	.string "Para ir a LAVARIDGE TOWN o a la\n"
	.string "cima, use el CABLE CAR.$"

Route112_Text_RouteSignLavaridge:
	.string "RUTA 112\n"
	.string "{LEFT_ARROW} LAVARIDGE TOWN$"

