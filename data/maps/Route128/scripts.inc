Route128_Text_ArchieWhatHappened:
	.string "ARCHIE: ¿Qué pasó...\n"
	.string "¿Qué es esta escena miserable...\p"
	.string "¿Acaso... cometí un error horrible?$"

Route128_Text_ArchieIOnlyWanted:
	.string "Yo...\n"
	.string "Solo quería...$"

Route128_Text_MaxieDoYouUnderstandNow:
	.string "MAXIE: ¿Lo entiendes ahora,\n"
	.string "ARCHIE?\p"
	.string "¿Ves al fin lo desastroso que fue\n"
	.string "tu sueño?\p"
	.string "¡Hay que apresurarse! ¡Hagamos\n"
	.string "algo antes de que la situación se\l"
	.string "salga totalmente de control!$"

Route128_Text_MaxieResposibilityFallsToArchieAndMe:
	.string "MAXIE: {PLAYER}, no digas nada.\p"
	.string "Sé que no tengo derecho a\n"
	.string "criticar a ARCHIE...\p"
	.string "Pero así como están las cosas, dudo\n"
	.string "que nosotros seamos capaces de\l"
	.string "hacer algo al respecto.\p"
	.string "Pero tampoco podemos quedarnos\n"
	.string "mirando sin hacer nada.\p"
	.string "La responsabilidad de terminar con\n"
	.string "esto recae en ARCHIE y en mí...$"

Route128_Text_MaxieThisDefiesBelief:
	.string "MAXIE: Es increíble...\p"
	.string "Esos POKéMON superantiguos...\p"
	.string "Su poder es inimaginable.\n"
	.string "Alteraron el equilibrio natural...$"

Route128_Text_StevenWhatIsHappening:
	.string "STEVEN: ¡{PLAYER}{KUN}!\n"
	.string "¿Qué está pasando?$"

Route128_Text_StevenWholeWorldWillDrown:
	.string "Esto es terrible...\p"
	.string "Tras la ola de calor abrasador,\n"
	.string "empezó este diluvio.\p"
	.string "Si no para, todo HOENN...\n"
	.string "No, el mundo entero se ahogará.\p"
	.string "Esta nube de lluvia se extiende\n"
	.string "sobre CIUDAD ARCOIRIS...\p"
	.string "¿Qué rayos está pasando allá?\p"
	.string "No sirve de nada discutir aquí...\n"
	.string "CIUDAD ARCOIRIS dará respuestas...$"

Route128_Text_StevenImGoingToSootopolis:
	.string "{PLAYER}{KUN}...\n"
	.string "No sé qué piensas hacer,\l"
	.string "pero no hagas nada imprudente.\p"
	.string "Está bien.\n"
	.string "Iré a CIUDAD ARCOIRIS.$"

