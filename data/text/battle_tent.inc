SlateportCity_BattleTentLobby_Text_ExplainBasicRules:
	.string "En el Intercambio, solo puedes usar\n"
	.string "tres POKéMON.\p"
	.string "Ya sea alquilando o cambiando,\n"
	.string "tu equipo no puede tener dos o más\l"
	.string "del mismo POKéMON.$"

SlateportCity_BattleTentLobby_Text_ExplainSwapPartnerRules:
	.string "Solo puedes cambiar POKéMON con el\n"
	.string "ENTRENADOR que acabas de vencer.\p"
	.string "Solo puedes cambiar por los POKéMON\n"
	.string "usados por el ENTRENADOR vencido.$"

SlateportCity_BattleTentLobby_Text_ExplainSwapNumberRules:
	.string "Tras cada victoria, puedes cambiar\n"
	.string "uno de tus POKéMON por uno del\l"
	.string "oponente derrotado.\p"
	.string "No podrás cambiar POKéMON con el\n"
	.string "tercer ENTRENADOR del evento.$"

SlateportCity_BattleTentLobby_Text_ExplainSwapNotes:
	.string "Hay dos puntos clave al intercambiar\n"
	.string "POKéMON.\p"
	.string "Primero, al cambiar, no puedes ver\n"
	.string "los stats del POKéMON que vas\l"
	.string "a recibir.\p"
	.string "Segundo, los POKéMON de tu equipo\n"
	.string "están en orden según cómo los\l"
	.string "alquilaste.\p"
	.string "Este orden no cambia aunque\n"
	.string "hagas intercambios.$"

SlateportCity_BattleTentLobby_Text_ExplainMonRules:
	.string "Los POKéMON de la TIENDA DE BATALLA:\n"
	.string "FACTORY son todos alquilados.\p"
	.string "Todos los POKéMON alquilados están al\n"
	.string "Nivel 50.$"

