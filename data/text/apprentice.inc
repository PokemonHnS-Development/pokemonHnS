	.string "¡OK, todo OK!\l"
	.string "¡Iré a demostrar mi valor!\p"
	.string "¡Bien, te veré como mi mentor!\n"
	.string "¡Adiós!$"

gText_ApprenticePleaseTeach10::
	.string "¡Oh, hola, {PLAYER}{KUN}, ¿verdad?\n"
	.string "¡La policía te buscaba!\p"
	.string "… … …\n"
	.string "¡Claro que miento!\p"
	.string "Yo soy {STR_VAR_1}. Aunque no lo\n"
	.string "parezca, ¡soy el CAMPEÓN POKéMON!\l"
	.string "…¡Eso también es mentira!\p"
	.string "Pero esto no es mentira.\n"
	.string "No soy muy bueno luchando.\p"
	.string "¿Qué tal si eres mi maestro en\n"
	.string "todo lo relacionado con POKéMON?$"

gText_ApprenticeRejectTeaching10::
	.string "Si vas a ser tan frío conmigo,\n"
	.string "¡te enseñaré lo que puedo hacer!\p"
	.string "¡Buaaa! ¡Buaaa! ¡Buaaa!\n"
	.string "¡Hic!\p"
	.string "¡Jajaja, eran LÁGRIMAS FALSAS!\p"
	.string "Vamos, ¿quieres ser mi\n"
	.string "maestro POKéMON?$"

