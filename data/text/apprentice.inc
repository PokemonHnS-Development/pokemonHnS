	.string "Gracias, {PLAYER}{KUN}.\n"
	.string "Si nos vemos, espero que seas\l"
	.string "tan amable.$"

gText_ApprenticeWhichMove15::
	.string "¿Hm? Pareces ser {PLAYER}{KUN}...\n"
	.string "¿Pero eres real?\p"
	.string "¿Quizás eres uno de esos imitadores\n"
	.string "tan populares?\p"
	.string "No, no, si eres real, está bien.\n"
	.string "¡No te enfades, te lo aseguro!\p"
	.string "Por cierto, me gustaría obtener\n"
	.string "tu consejo.\p"
	.string "Es sobre mi {STR_VAR_1}.\p"
	.string "¿Qué ataque sería mejor usar,\n"
	.string "{STR_VAR_2} o {STR_VAR_3}?$"

gText_ApprenticeMoveThanks15::
	.string "¿{STR_VAR_1}?\n"
	.string "¿No hay duda sobre eso?\p"
	.string "Ya veo. Si es así, está bien.\n"
	.string "Te agradezco tu tiempo.\p"
	.string "Espero que sea algo que incluso\n"
	.string "mi POKéMON pueda aprender.\p"
	.string "¡Nos vemos pronto!$"

gText_ApprenticePickWinSpeech0::
	.string "Oh… ¿{PLAYER}?\n"
	.string "¡Es {PLAYER}!\l"
	.string "¡Oh! Snif… bua… ¡Escucha!\p"
	.string "Yo… Al luchar, me pongo nervioso,\n"
	.string "lloro aunque gane la batalla…\p"
	.string "Quisiera decir algo genial\n"
	.string "cuando gane…\p"
	.string "¡Por favor, {PLAYER}!\n"
	.string "¿Podrías enseñarme algo genial\l"
	.string "para decir y así no llorar?$"

gText_ApprenticeWinSpeechThanks0::
	.string "{STR_VAR_1}\p"
	.string "¡Genial! ¡Increíble! ¡Awoooh!\n"
	.string "¡Es muy cool!\p"
	.string "Oh… lo siento…\n"
	.string "Estoy tan feliz que lloro…\p"
	.string "Snif… ¡{PLAYER}!\n"
	.string "¡Muchas gracias por todo!\p"
	.string "Lucharé lo mejor que pueda por\n"
	.string "ti, {PLAYER}!\p"
	.string "{PLAYER}…\n"
	.string "¡La próxima vez… lucharemos!$"

gText_ApprenticePickWinSpeech1::
	.string "¡Sii! ¡Es {PLAYER}! ¡Hola!\n"
	.string "¡Quería preguntarte algo!\p"
	.string "Quiero decir algo genial cuando\n"
	.string "gane un combate.\p"
	.string "¿Tienes alguna frase genial que\n"
	.string "me puedas recomendar?$"

gText_ApprenticeWinSpeechThanks1::
	.string "{STR_VAR_1}\p"
	.string "¡Oh, vaya! ¡Eso es genial!\n"
	.string "¡Vale, diré eso!\p"
	.string "¡Gracias por enseñarme todo esto!\n"
	.string "¡Daré lo mejor de mí\l"
	.string "dondequiera que vaya ahora!\p"
	.string "¡Cuando nos veamos, será para\n"
	.string "una batalla!$"

gText_ApprenticePickWinSpeech2::
	.string "{PLAYER}, ¡hola!\p"
	.string "Mis POKéMON y yo estamos listos\n"
	.string "para todo, salvo una cosa.\p"
	.string "Creo que sería bueno tener\n"
	.string "algo que gritar al ganar.\p"
	.string "¿Podrías pensar en algo bueno\n"
	.string "para decir?$"

gText_ApprenticeWinSpeechThanks2::
	.string "{STR_VAR_1}\p"
	.string "…¡Genial!\n"
	.string "¡Usaré eso!\p"
	.string "Saldré a luchar por todas\n"
	.string "partes.\p"
	.string "Quién sabe, quizá luche contra\n"
	.string "ti algún día, {PLAYER}.\p"
	.string "¡La próxima vez, nos vemos en\n"
	.string "una batalla!$"

gText_ApprenticePickWinSpeech3::
	.string "Hola, {PLAYER}…\n"
	.string "Siento molestarte, pero no puedo…\p"
	.string "Incluso cuando…\n"
	.string "Incluso si gano, no tengo nada\l"
	.string "especial que decir…\p"
	.string "Sé que no importa mucho\n"
	.string "para ti, {PLAYER}.\p"
	.string "Pero para mí es muy importante…\p"
	.string "Por favor, {PLAYER}, ¿qué digo\n"
	.string "si gano una batalla?$"

gText_ApprenticeWinSpeechThanks3::
	.string "{STR_VAR_1}\p"
	.string "Eso es inspirador...\p"
	.string "Eh... ¿está bien que alguien como yo\n"
	.string "diga algo así?\p"
	.string "¡No! ¡Daré lo mejor de mí!\p"
	.string "{PLAYER}, gracias por tenerme\n"
	.string "paciencia durante tanto tiempo...\p"
	.string "Prometo esforzarme de ahora en más.\p"
	.string "Seguro que me olvidarás pronto,\n"
	.string "¡pero volvamos a vernos\l"
	.string "en algún lugar!$"

gText_ApprenticePickWinSpeech4::
	.string "Oh, {PLAYER}{KUN}.\n"
	.string "Hay algo que quiero que escuches.\p"
	.string "Sé que no siempre sueno\n"
	.string "amable o educado…\p"
	.string "Cuando gano, creo que parezco\n"
	.string "alguien arrogante.\p"
	.string "No quiero que me odien,\n"
	.string "así que quiero decir algo lindo a\l"
	.string "quien derrote.\p"
	.string "¡Pero no se me ocurre nada!\n"
	.string "¿Podrías pensar algo por mí?$"

gText_ApprenticeWinSpeechThanks4::
	.string "{STR_VAR_1}\p"
	.string "¡Nada mal!\n"
	.string "¡Sí, usaré eso!\p"
	.string "Me pondré en camino y haré lo\n"
	.string "posible con lo que me enseñaste\l"
	.string "de corazón.\p"
	.string "¡Siento haber sido tan insistente\n"
	.string "contigo!\p"
	.string "La próxima luchamos, ¿vale?\n"
	.string "¡Nos vemos!$"

gText_ApprenticePickWinSpeech5::
	.string "¡No supero lo ocupado que estoy!\n"
	.string "Ah, hola, te buscaba, {PLAYER}{KUN}.\p"
	.string "¿Estás bien, como siempre?\n"
	.string "Para mí nada ha cambiado.\p"
	.string "Tengo que correr, luchar y mapear.\n"
	.string "¿Por qué estoy tan ocupado?\p"
	.string "Pero aunque lo esté, sería grosero\n"
	.string "darme la vuelta e irme\l"
	.string "sin decir nada tras ganar.\p"
	.string "¿Qué frase genial resaltaría mi\n"
	.string "estilo al marcharme?\l"
	.string "{PLAYER}{KUN}, ¡ayúdame!$"

gText_ApprenticeWinSpeechThanks5::
	.string "{STR_VAR_1}\p"
	.string "Vale, entiendo.\n"
	.string "¡Tendré tiempo de decir eso!\p"
	.string "Honestamente, me alegra haber\n"
	.string "tenido un mentor como tú.\p"
	.string "Haré tiempo de alguna forma para\n"
	.string "dedicarme a las batallas.\p"
	.string "¡Gracias por todo, {PLAYER}{KUN}!\n"
	.string "¡Algún día lucharemos tú y yo!$"

gText_ApprenticePickWinSpeech6::
	.string "¡Tuve suerte otra vez!\n"
	.string "{PLAYER}! ¡Qué alegría verte!\l"
	.string "¡Como siempre, necesito tu consejo!\p"
	.string "¡Redoble de tambores!\n"
	.string "Mi última pregunta es…\p"
	.string "Si gano una batalla y quiero\n"
	.string "cerrar con estilo, ¿qué\l"
	.string "debería decir?$"

gText_ApprenticeWinSpeechThanks6::
	.string "{STR_VAR_1}\p"
	.string "Eso… ¡Eso es fabuloso!\n"
	.string "¡Es digno y genial! ¡La usaré!\p"
	.string "…Oye, creo que me estoy volviendo\n"
	.string "bueno en esto, ¿eh?\p"
	.string "Pienso retar a otros\n"
	.string "ENTRENADORES desde ahora.\p"
	.string "{PLAYER}, tu consejo me ayudó mucho.\p"
	.string "¡Quizás algún día\n"
	.string "lucharemos!\p"
	.string "¡Gracias por todo!$"

gText_ApprenticePickWinSpeech7::
	.string "Oh, {PLAYER}.\n"
	.string "¡Me alegra mucho conocerte!\p"
	.string "Ya no tengo preocupaciones\n"
	.string "sobre mis POKéMON.\p"
	.string "Lo que me preocupa soy yo…\p"
	.string "¿Sabes qué dice un ENTRENADOR\n"
	.string "al ganar una batalla?\p"
	.string "¡Definitivamente yo también\n"
	.string "quisiera hacer eso!\p"
	.string "Por favor, ¿qué debería decir\n"
	.string "cuando gane una batalla?$"

gText_ApprenticeWinSpeechThanks7::
	.string "{STR_VAR_1}\p"
	.string "¡Ah! ¡Esa frase! ¡Me refresca\n"
	.string "y me hace sentir renacido!\p"
	.string "¡Debo usarla ahora mismo!\p"
	.string "Y ahora, debo marcharme,\n"
	.string "{PLAYER}…\p"
	.string "Lucharé contra muchos otros,\n"
	.string "pero no olvidaré tus enseñanzas.\p"
	.string "Tal vez algún día…\n"
	.string "¡Adiós!$"

gText_ApprenticePickWinSpeech8::
	.string "¡Ay! ¡Vi a {PLAYER}!\n"
	.string "¡Estoy feliz de verte!\p"
	.string "¡Oh-oh-oh! ¡Hay algo que\n"
	.string "tengo que preguntarte!\p"
	.string "Hace poco gané una batalla.\n"
	.string "¡Fue muy emocionante!\p"
	.string "¡Pero me puse tan feliz que\n"
	.string "me trabé y no pude decir nada!\p"
	.string "¡{PLAYER}, por favor, piensa\n"
	.string "una frase para cuando yo gane!$"

gText_ApprenticeWinSpeechThanks8::
	.string "{STR_VAR_1}\p"
	.string "¡Waaaaah!\n"
	.string "¡¿Voy a decir eso?!\l"
	.string "¡Estoy... delirando de alegría!\p"
	.string "¡Gr-gr-gracias!\n"
	.string "¡Ya no me queda nada que lamentar!\p"
	.string "Ahora viajaré y lucharé\n"
	.string "contra todo tipo de gente.\p"
	.string "Te debo todo, {PLAYER}.\n"
	.string "¡De verdad, muchas gracias!\p"
	.string "Debo irme, ¡pero luchemos\n"
	.string "algún día!$"

gText_ApprenticePickWinSpeech9::
	.string "¡Hola, bueno!\n"
	.string "{PLAYER}{KUN}!\p"
	.string "Sabes, tengo ganas de viajar\n"
	.string "y luchar donde sea.\p"
	.string "Pero antes, quiero tu consejo\n"
	.string "una vez más, ¡por favor!\p"
	.string "Si gano una batalla, ¿qué sería\n"
	.string "un buen alarde para decirle al\l"
	.string "ENTRENADOR derrotado?$"

gText_ApprenticeWinSpeechThanks9::
	.string "{STR_VAR_1}\p"
	.string "¡Uh-huh, qué dulce!\n"
	.string "¡Sí, genial!\l"
	.string "¡Intentaré decir eso, a tope!\p"
	.string "¡Y ahora, es hora de decir adiós!\n"
	.string "¡Gracias por todas las cosas!\p"
	.string "Dame una batalla algún día, ¿ok?\n"
	.string "¡Adiós!$"

gText_ApprenticePickWinSpeech10::
	.string "{PLAYER}{KUN}, ¡hay un gran problema!\p"
	.string "Cuando gano, presumo de ello\n"
	.string "¡por al menos una hora!\p"
	.string "¡Claro que miento!\n"
	.string "¡Wahahaha!\p"
	.string "Pero esto no es mentira.\n"
	.string "No soy muy bueno charlando.\p"
	.string "Entonces, ¿decides por mí qué\n"
	.string "decir tras ganar una batalla,\l"
	.string "maestro?$"

gText_ApprenticeWinSpeechThanks10::
	.string "{STR_VAR_1}\p"
	.string "¿Eso es lo que debo decir, eh?\n"
	.string "¡Entonces evitaré decir eso!\p"
	.string "¡Es broma!\n"
	.string "¡Obedeceré tus enseñanzas, maestro!\p"
	.string "¡Gracias por enseñarme todo este\n"
	.string "tiempo, maestro!\p"
	.string "Al fin entiendo qué significa ser\n"
	.string "un ENTRENADOR.\p"
	.string "Saldré a ganar batallas\n"
	.string "contra cualquier ENTRENADOR.\p"
	.string "¡Quizás seas tú algún día, maestro!\p"
	.string "¡Eso es todo!\n"
	.string "¡Adiós, mi maestro!$"

gText_ApprenticePickWinSpeech11::
	.string "¡A-H-O-Y!\n"
	.string "¡Y eso se deletrea ahoy!\p"
	.string "¡Soy el MARINERO rapero!\n"
	.string "Será mi última pregunta,\l"
	.string "¡no llores!\p"
	.string "¡Es una pregunta de frases\n"
	.string "que pide tu sugerencia!\p"
	.string "Si gano un combate, ¿qué puedo decir\n"
	.string "de forma muy genial?$"

gText_ApprenticeWinSpeechThanks11::
	.string "{STR_VAR_1}\p"
	.string "¡Perfecto! Usaré eso.\n"
	.string "¡Hice bien en dejarte elegir!\p"
	.string "¡Y ahora creo que lo mejor\n"
	.string "será volar del nido!\p"
	.string "Gracias por todo lo que enseñaste.\n"
	.string "¡Me voy a una racha de batallas!\p"
	.string "¡B-O-N-V-O-Y-A-G-E!\n"
	.string "¡Eso es bon voyage,\l"
	.string "¡mi homenaje para ti!$"

gText_ApprenticePickWinSpeech12::
	.string "¡Ah, sí, {PLAYER}!\n"
	.string "¡Te encontré otra vez!\p"
	.string "¿Qué hago? ¿Te pregunto otra vez?\n"
	.string "¡Claro! ¡Ya te estoy preguntando!\p"
	.string "En fin, {PLAYER}...\n"
	.string "¿Me escuchas?\l"
	.string "¡Me escuchas!\l"
	.string "¡Necesito más consejos!\p"
	.string "Es sobre qué debería gritar.\n"
	.string "Algo genial para decir cuando\l"
	.string "una batalla termine bien.\p"
	.string "¡Vamos, quiero oírte decirlo!$"

gText_ApprenticeWinSpeechThanks12::
	.string "{STR_VAR_1}\p"
	.string "¡Está bien, está bien!\n"
	.string "¡Lo usaré porque es genial!\p"
	.string "Ya no tengo más que preguntarte.\n"
	.string "Solo queda decir adiós con la mano.\p"
	.string "Quizá algún día nos veamos,\n"
	.string "y uno deba ser derrotado.\p"
	.string "Pero ya es hora de despedirnos.\p"
	.string "Bueno, {PLAYER}, debo ser libre,\n"
	.string "¡pero no te olvides de mí!\p"
	.string "¡Cuídate, {PLAYER}!\n"
	.string "¡Te quiero!$"

gText_ApprenticePickWinSpeech13::
	.string "{PLAYER}{KUN}, terminé...\n"
	.string "No deja de gotear mi nariz...\p"
	.string "Intentaba pensar en algo\n"
	.string "genial para decir al ganar.\p"
	.string "Me inspiró tanto que lloré,\n"
	.string "y ahora mi nariz no para...\p"
	.string "Así que, estando así las cosas,\n"
	.string "tú decide por mí, {PLAYER}{KUN}.\p"
	.string "Cuando gane una batalla,\n"
	.string "¿qué debería decir?$"

gText_ApprenticeWinSpeechThanks13::
	.string "{STR_VAR_1}\p"
	.string "... ... ...Está bien.\n"
	.string "¡No, es impresionante!\l"
	.string "¡Me hace brotar nuevas lágrimas!\p"
	.string "A pesar de mis lágrimas y mi\n"
	.string "nariz, ¡usaré esa frase!\p"
	.string "Ya no tengo más que preguntarte,\n"
	.string "{PLAYER}{KUN}.\p"
	.string "¡De ahora en adelante, somos rivales!\n"
	.string "¡Gracias por todo!$"

gText_ApprenticePickWinSpeech14::
	.string "Eh... Este...\n"
	.string "{PLAYER}{KUN}...\p"
	.string "Por favor, no me mires así.\n"
	.string "Me pones muy nervioso.\p"
	.string "Yo... necesito tu consejo otra vez.\n"
	.string "Será el último, aunque...\p"
	.string "Es vergonzoso preguntar,\n"
	.string "¿pero y si gano una batalla?\l"
	.string "¿Qué debería decir?$"

gText_ApprenticeWinSpeechThanks14::
	.string "{STR_VAR_1}\p"
	.string "¡Oh... De acuerdo!\n"
	.string "¡Intentaré decir eso!\l"
	.string "Quizá esté muy nerviosa...\p"
	.string "Gracias, {PLAYER}{KUN}.\n"
	.string "Debo despedirme ahora.\p"
	.string "Seguiré todo lo que me enseñaste,\n"
	.string "{PLAYER}{KUN}, y daré lo mejor.$"

gText_ApprenticePickWinSpeech15::
	.string "¿Hm? Pareces ser {PLAYER}{KUN}...\n"
	.string "¿Pero lo eres realmente?\l"
	.string "¿Quizá un MUÑECO de {PLAYER}?\p"
	.string "¡Oh, no, no, no, no te preocupes!\n"
	.string "Si eres real, por favor\l"
	.string "olvida mi grosería.\p"
	.string "No te enojes. Solo deseo\n"
	.string "más de tus buenos consejos.\p"
	.string "Es sobre una frase.\p"
	.string "Más preciso, ¿qué debería decir\n"
	.string "si gano una batalla?$"

gText_ApprenticeWinSpeechThanks15::
	.string "{STR_VAR_1}\p"
	.string "... ... ... ... ... ...\n"
	.string "Cuando gane un combate...\p"
	.string "{STR_VAR_1}\p"
	.string "...¿Hablas en serio?\p"
	.string "Ya veo. Si es en serio, está bien.\n"
	.string "Te agradezco tu tiempo.\p"
	.string "Espero que yo también pueda\n"
	.string "usar bien esa frase.\p"
	.string "Parece que ya no necesito\n"
	.string "más consejos.\p"
	.string "Creo que es hora de despedirme\n"
	.string "y seguir mi propio camino.\p"
	.string "¡Gracias, mi mentor!\n"
	.string "¡Perdón por mi escepticismo!$"
