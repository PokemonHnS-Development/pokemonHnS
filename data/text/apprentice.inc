	.string "¿Cuál me queda mejor?$"

gText_ApprenticeLevelModeThanks6::
	.string "¡Oh-oh-oh!\n"
	.string "¡Dices {STR_VAR_1}!\l"
	.string "¡Gracias por una respuesta genial!\p"
	.string "Creo que eso es todo lo que quería\n"
	.string "preguntarte hoy.\p"
	.string "Reunámonos aquí otra vez, ¿vale?\n"
